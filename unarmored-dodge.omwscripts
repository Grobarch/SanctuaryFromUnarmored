# Unarmored Dodge
# A Sanctuary effect scaled from the Unarmored skill (and, to a lesser extent, from
# Light/Medium/Heavy Armor). Lua-only, requires OpenMW >= 0.51 (the I.Combat interface).
#
# No CREATURE: creatures have no real Unarmored skill (the engine derives their value from
# a specialisation) and get no vanilla armour rating from it either, so there is nothing to
# scale. Not registering for them means zero cost on every creature in the world.

MENU: scripts/unarmored_dodge/slider.lua
MENU: scripts/unarmored_dodge/menu.lua
GLOBAL: scripts/unarmored_dodge/global.lua
NPC,PLAYER: scripts/unarmored_dodge/actor.lua
NPC,PLAYER: scripts/unarmored_dodge/armor.lua
PLAYER: scripts/unarmored_dodge/player.lua
PLAYER: scripts/unarmored_dodge/statswindow.lua
PLAYER: scripts/unarmored_dodge/inventorybar.lua
